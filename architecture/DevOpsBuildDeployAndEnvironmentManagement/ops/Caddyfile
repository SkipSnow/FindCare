# ChatHealthy.ai — Local Development Caddyfile
# Routes all traffic through single entry point with TLS + mTLS
# Each service has its own certificate for proper PKI identity.
#
# PKI Chain:
#   CA:             ChatHealthy Local CA (ca.crt/ca.key)
#   Website:        CN=localhost         (localhost.crt/key)     :443
#   FindCare:       CN=findcare.local    (findcare.crt/key)     :8080
#   EvaluateCare:   CN=evalcare.local    (evalcare.crt/key)     :8081  mTLS
#   Shared Services:CN=shared.local      (shared.crt/key)       :8082  mTLS
#
# Ports:
#   :80/:443 → Website/ static files (localhost cert)
#   :5173    → React frontend (Vite dev server, proxied)
#   :8080    → FindCare backend (findcare cert, no client auth)
#   :8081    → EvaluateCare backend (evalcare cert, mTLS required)
#   :8082    → Shared Services (shared cert, mTLS required)

{
	# Local dev — no automatic HTTPS, we manage our own certs
	auto_https off
	admin off
}

# ── HTTP :80 — redirect index only, reject everything else ────
:80 {
	handle / {
		redir https://{host}/ permanent
	}
	handle /index.html {
		redir https://{host}/index.html permanent
	}
	handle {
		header Upgrade "TLS/1.2, HTTP/1.1"
		header Connection "Upgrade"
		respond "426 Upgrade Required — This server refuses HTTP requests and does not accept redirecting on your behalf. Use HTTPS." 426
	}
}

# ── Public Website (HTTPS only) ───────────────────────
:443 {
	tls {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/localhost.crt {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/localhost.key

	# API proxy — same origin, no mixed content
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy localhost:8000
	}

	# Static website
	handle {
		root * {$CHATHEALTHY_PROJECT_ROOT}/Website
		file_server
	}
}

# ── React Frontend (HTTPS proxy to Vite dev server) ───
:3000 {
	tls {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/localhost.crt {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/localhost.key
	reverse_proxy localhost:5173
}

# ── FindCare API (findcare cert, no client auth for consumers) ─
:8080 {
	tls {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/findcare.crt {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/findcare.key
	reverse_proxy localhost:8000
}

# ── EvaluateCare API (evalcare cert, mTLS required) ────
:8081 {
	tls {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/evalcare.crt {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/evalcare.key {
		client_auth {
			mode require_and_verify
			trust_pool file {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/ca.crt
		}
	}
	reverse_proxy localhost:8001
}

# ── Shared Services API (shared cert, mTLS required) ───
:8082 {
	tls {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/shared.crt {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/shared.key {
		client_auth {
			mode require_and_verify
			trust_pool file {$CHATHEALTHY_PROJECT_ROOT}/Code/Shared/ops/certs/ca.crt
		}
	}
	reverse_proxy localhost:8002
}
