{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true
  },
  "include": [
    "Code/ConversationalUX/FindCareChat/frontend/src",
    "FindCare/**/*.tsx",
    "FindCare/**/*.ts",
    "sharedServices/Code/**/*.tsx",
    "sharedServices/Code/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/build",
    "Website/functions"
  ]
}
